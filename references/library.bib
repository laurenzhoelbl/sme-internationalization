@misc{zhuEvolutionaryPerspectivesEvaluation2025,
  title = {Evolutionary {{Perspectives}} on the {{Evaluation}} of {{LLM-Based AI Agents}}: {{A Comprehensive Survey}}},
  shorttitle = {Evolutionary {{Perspectives}} on the {{Evaluation}} of {{LLM-Based AI Agents}}},
  author = {Zhu, Jiachen and Zhu, Menghui and Rui, Renting and Shan, Rong and Zheng, Congmin and Chen, Bo and Xi, Yunjia and Lin, Jianghao and Liu, Weiwen and Tang, Ruiming and Yu, Yong and Zhang, Weinan},
  year = 2025,
  month = jun,
  number = {arXiv:2506.11102},
  eprint = {2506.11102},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2506.11102},
  urldate = {2026-05-05},
  abstract = {The advent of large language models (LLMs), such as GPT, Gemini, and DeepSeek, has significantly advanced natural language processing, giving rise to sophisticated chatbots capable of diverse language-related tasks. The transition from these traditional LLM chatbots to more advanced AI agents represents a pivotal evolutionary step. However, existing evaluation frameworks often blur the distinctions between LLM chatbots and AI agents, leading to confusion among researchers selecting appropriate benchmarks. To bridge this gap, this paper introduces a systematic analysis of current evaluation approaches, grounded in an evolutionary perspective. We provide a detailed analytical framework that clearly differentiates AI agents from LLM chatbots along five key aspects: complex environment, multisource instructor, dynamic feedback, multi-modal perception, and advanced capability. Further, we categorize existing evaluation benchmarks based on external environments driving forces, and resulting advanced internal capabilities. For each category, we delineate relevant evaluation attributes, presented comprehensively in practical reference tables. Finally, we synthesize current trends and outline future evaluation methodologies through four critical lenses: environment, agent, evaluator, and metrics. Our findings offer actionable guidance for researchers, facilitating the informed selection and application of benchmarks in AI agent evaluation, thus fostering continued advancement in this rapidly evolving research domain.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language},
  file = {/Users/laurenzhoelbl/Zotero/storage/VCJB5792/Zhu et al. - 2025 - Evolutionary Perspectives on the Evaluation of LLM-Based AI Agents A Comprehensive Survey.pdf}
}
